# Neon PostgreSQL Configuration (Set this in Vercel Project Settings > Environment Variables)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_sample_password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# (Optional) Supabase Realtime broadcast configuration (if using multiplayer party screen sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
